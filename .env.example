# ── J.A.R.V.I.S. CORE ──────────────────────────────────────────────
# The app runs with a built-in simulation core by default. No keys needed.
# To use a real model, add a key below (or save one in Settings → Model).

PORT=8787
JARVIS_DATA_DIR=./data

# OpenAI-compatible / native providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional: better live web search (Tavily, free tier available)
TAVILY_API_KEY=
